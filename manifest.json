{
  "manifest_version": "0.4",
  "name": "google-chat",
  "display_name": "Google Chat",
  "version": "0.2.0",
  "description": "Local Google Chat MCP tools for reading and explicitly authorized text sends.",
  "long_description": "Reads spaces and messages, and sends plain-text messages or strict thread replies using a caller-supplied idempotency UUID.",
  "author": {
    "name": "Antstudio",
    "url": "https://github.com/antstudiocz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antstudiocz/ant-google-chat.git"
  },
  "homepage": "https://github.com/antstudiocz/ant-google-chat",
  "documentation": "https://github.com/antstudiocz/ant-google-chat#readme",
  "privacy_policies": ["https://policies.google.com/privacy"],
  "license": "MIT",
  "server": {
    "type": "uv",
    "entry_point": "src/google_chat_plugin/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--project", "${__dirname}", "--frozen", "python", "-m", "google_chat_plugin.server"]
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "python": ">=3.11,<4.0"
    }
  },
  "tools_generated": true,
  "keywords": ["google-chat", "mcp", "codex", "claude"]
}
